[
  { "type": "heading", "defaultValue": "Hol Horse config" },
  { "type": "section",
    "items": [
      { "type": "heading", "defaultValue": "Colours"},
      { "type": "select", "messageKey": "theme", "label": "Theme",
        "defaultValue": "Emperor",
        "options": [
          {"label": "Emperor", "value": "Emperor" },
          {"label": "The World", "value": "The World" },
          {"label": "Silver Chariot", "value": "Silver Chariot" },
          {"label": "Custom", "value": "Custom" }
        ]
      },
      { "type": "color", "messageKey": "bgColor", "label": "Background", "defaultValue": "000000" },
      { "type": "color", "messageKey": "fgColor", "label": "Foreground", "defaultValue": "ffffff" },
      { "type": "color", "messageKey": "hourColor", "label": "Hour Hand", "defaultValue": "ffffff" },
      { "type": "color", "messageKey": "minuteColor", "label": "Minute Hand", "defaultValue": "ffffff" }
    ]
  },
  { "type": "section",
    "items": [
      { "type": "heading", "defaultValue": "Misc"},
      { "type": "select", "messageKey": "animationSpeed", "label": "Animation speed",
        "defaultValue": "0",
        "options": [
          {"label": "Normal", "value": "0" },
          {"label": "Fast",   "value": "1" },
          {"label": "Off",    "value": "2" }
        ]
      }
    ]
  },
  { "type": "section",
    "items": [
      { "type": "heading", "defaultValue": "Background features" },
      { "type": "color", "messageKey": "faceTextColor", "label": "Brand text / meter color", "defaultValue": "aaaaaa" },
      { "type": "toggle", "messageKey": "faceTextEnabled", "label": "Brand text", "defaultValue": false },
      { "type": "input", "messageKey": "faceText", "group": "faceTextEnabledToggleGroup",
        "defaultValue": "pebble",
        "attributes": {"maxlength": 10,  "pattern": "[a-zA-Z. ]*"}
      },

      { "type": "toggle", "messageKey": "batteryMeterEnabled", "label": "Battery meter", "defaultValue": false },
      { "type": "slider", "messageKey": "batteryLowPercent", "label": "Low battery warning %",
        "group": "batteryMeterEnabledToggleGroup",
        "description": "Meter changes colour at this % remaining",
        "defaultValue": 20,
        "min": 1, "max": 100, "step": 1
      },
      { "type": "color", "messageKey": "batteryLowColor", "group": "batteryMeterEnabledToggleGroup",
        "label": "Low battery colour", "defaultValue": "ff0000" }
    ]
  },
